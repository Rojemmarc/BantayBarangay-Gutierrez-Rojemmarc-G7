# Copy to .env in the project root or backend/ (never commit .env).
# Production requires DEBUG=0 and a long random SECRET_KEY.
DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# PostgreSQL / Supabase connection string (Transaction or Session pooler):
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_SSL=1
SSL_REDIRECT=0
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BantayBarangay <no-reply@example.com>
MEDIA_ROOT=/data/media
